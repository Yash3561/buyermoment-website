# Public build settings. These appear in browser assets.
VITE_CALENDLY_URL=https://calendly.com/yashchaudhary3561/30min
VITE_AUDIT_ENABLED=false
VITE_GOOGLE_AUTH_ENABLED=false
VITE_SUPABASE_URL=https://YOUR-PUBLIC-WEBSITE-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC-PUBLISHABLE-KEY
# Legacy VITE_SUPABASE_ANON_KEY remains supported when a publishable key is absent.

# Server only. Never prefix a privileged secret key with VITE_.
AUDIT_ACCOUNTS_ENABLED=false
SUPABASE_URL=https://YOUR-PUBLIC-WEBSITE-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR-SERVER-ONLY-SECRET-KEY
# SUPABASE_SERVICE_ROLE_KEY is a temporary legacy fallback. Remove after migration.
CHECKER_DISABLED=0
