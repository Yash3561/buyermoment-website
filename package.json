{
  "name": "contextlumen-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check-build.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:audit-live": "node scripts/audit-launch-preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:api": "node scripts/dev-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.2.0",
    "jspdf": "4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
